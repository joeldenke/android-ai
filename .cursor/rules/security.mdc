## EncryptedSharedPreferences

For tokens, refresh tokens, user IDs, and small structured secrets. For large blobs use Tink + `EncryptedFile` or DataStore + manual encryption.

```kotlin
// data/storage/SecureStorage.kt
class SecureStorage @Inject constructor(
    @ApplicationContext context: Context,
) {
    private val masterKey: MasterKey = MasterKey.Builder(context)
        .setKeyScheme(MasterKey.KeyScheme.AES256_GCM)
        .setUserAuthenticationRequired(false) // set true for biometric-gated keys
        .build()

    private val prefs: SharedPreferences = EncryptedSharedPreferences.create(
        context,
        "secure_prefs",
        masterKey,
        EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,
        EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM,
    )

    fun putToken(token: String) = prefs.edit { putString(KEY_TOKEN, token) }
    fun getToken(): String? = prefs.getString(KEY_TOKEN, null)
    fun clear() = prefs.edit { clear() }

    private companion object {
        const val KEY_TOKEN = "auth_token"
    }
}
```

### Migration From Plain Prefs

```kotlin
class SecureStorageMigrator @Inject constructor(
    @ApplicationContext private val context: Context,
    private val secure: SecureStorage,
) {
    fun migrateOnce() {
        val legacy = context.getSharedPreferences("legacy_prefs", Context.MODE_PRIVATE)
        legacy.getString("auth_token", null)?.let { token ->
            secure.putToken(token)
            legacy.edit { remove("auth_token") }
        }
        // Repeat for each migrated key, then delete the legacy file when empty.
        if (legacy.all.isEmpty()) {
            context.deleteSharedPreferences("legacy_prefs")
        }
    }
}
```

Run the migrator once in `Application.onCreate()` (idempotent — safe to call repeatedly).

