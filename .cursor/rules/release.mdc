## Rule 3 — `signingConfigs` Block

```kotlin
// app/build.gradle.kts
android {
    signingConfigs {
        create("release") {
            storeFile     = prop("RELEASE_STORE_FILE")?.let(::file)
            storePassword = prop("RELEASE_STORE_PASSWORD")
            keyAlias      = prop("RELEASE_KEY_ALIAS")
            keyPassword   = prop("RELEASE_KEY_PASSWORD")

            // Modern signing schemes — Android 11+ requires v2; v4 adds incremental install
            enableV1Signing = false
            enableV2Signing = true
            enableV3Signing = true
            enableV4Signing = true
        }
    }

    buildTypes {
        release {
            isMinifyEnabled    = true
            isShrinkResources  = true
            isDebuggable       = false
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro",
            )
            signingConfig = signingConfigs.getByName("release")
        }
        debug {
            applicationIdSuffix = ".debug"
            versionNameSuffix   = "-debug"
            isDebuggable        = true
            // Debug uses the auto-generated debug keystore — never the release one
        }
    }
}
```

**CI environment variables (GitHub Actions, GitLab CI, Bitrise):**

```
RELEASE_KEYSTORE_BASE64     base64 -i example-release.jks   (paste into Secrets)
RELEASE_STORE_PASSWORD
RELEASE_KEY_ALIAS
RELEASE_KEY_PASSWORD
PLAY_SERVICE_ACCOUNT_JSON   GCP service account JSON; needs "Release Manager" role on the app
GITHUB_TOKEN                provided automatically by GitHub Actions
```

```yaml
# In CI: decode to runner.temp, never the workspace
- name: Decode keystore
  run: echo "${{ secrets.RELEASE_KEYSTORE_BASE64 }}" | base64 --decode > ${{ runner.temp }}/release.jks

- name: Build release bundle
  env:
    RELEASE_STORE_FILE:     ${{ runner.temp }}/release.jks
    RELEASE_STORE_PASSWORD: ${{ secrets.RELEASE_STORE_PASSWORD }}
    RELEASE_KEY_ALIAS:      ${{ secrets.RELEASE_KEY_ALIAS }}
    RELEASE_KEY_PASSWORD:   ${{ secrets.RELEASE_KEY_PASSWORD }}
  run: ./gradlew bundleRelease

- name: Shred keystore
  if: always()
  run: shred -u ${{ runner.temp }}/release.jks
```

